    "c3_open": {
      "id": "c3_open",
      "act": 3,
      "phase": "FREE",
      "type": "story",
      "date": "1958年8月20日",
      "time": "傍晚六点",
      "location": "机身铆接车间",
      "visual": "assembly",
      "text": "蒙皮上的孔向下偏了半毫米。小林说自己按定位规划的线，季文坚持先报废这块板。\n\n报废会让装配线停一天。硬把铆钉打进去，机身受振后可能从孔边起裂。\n\n笔记本写着一句话，别只看板，看看递工具的人。小林把那把定位规攥在手里。",
      "goto": "c3_search"
    },
    "c3_search": {
